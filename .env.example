# ---- Required ----
DATABASE_URL="postgresql://user:password@localhost:5432/deltapro"
AUTH_SECRET="generate with: npx auth secret"
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:9002"
# Public base URL for links in emails, webhook URLs and OAuth redirects (defaults to AUTH_URL)
APP_URL="http://localhost:9002"

# Encrypts connector credentials at rest (falls back to AUTH_SECRET). Changing it makes stored credentials unreadable.
INTEGRATIONS_ENCRYPTION_KEY=""
# Bearer token Cloud Scheduler sends to /api/cron/{dispatch|auto-logout|sync|cleanup|all}
CRON_SECRET=""

# ---- Sign-in ----
# Comma-separated emails that become ADMIN when they first sign up or sign in with SSO
AUTH_ADMIN_EMAILS=""
# Restrict sign-up and SSO to these email domains (comma-separated). Empty = any domain.
AUTH_ALLOWED_DOMAINS=""
# Set to false to turn off self-service sign-up
AUTH_ALLOW_SIGNUP=true

# Google SSO (also used for Google Calendar OAuth unless GOOGLE_OAUTH_CLIENT_ID is set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Microsoft Entra ID SSO (also used for Outlook OAuth unless MICROSOFT_OAUTH_CLIENT_ID is set)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# ---- Connector OAuth apps (optional) ----
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_TENANT="common"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# ---- Email fallback when no Email integration exists (password reset) ----
RESEND_API_KEY=""
EMAIL_FROM="DeltaPro <noreply@yourcompany.com>"

# ---- AI rota explanations (Genkit + Gemini) ----
GEMINI_API_KEY=""
